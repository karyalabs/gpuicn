---
import Docs from "../../layouts/Docs.astro"
import Aside from "../../components/Aside.astro"
import Code from "../../components/Code.astro"
import Preview from "../../components/Preview.astro"
import { addedLabel, categories, categoryOf, components, componentHref, isNew } from "../../lib/catalog"
import { componentDocs } from "../../lib/docs"

export function getStaticPaths() {
  return components.map((component) => ({ params: { slug: component.slug }, props: { component } }))
}

const { component } = Astro.props
const docs = componentDocs(component.slug)
const category = categoryOf(component)
// Previous and next follow the sidebar: category by category.
const sidebarOrder = categories.flatMap((item) => item.components)
const index = sidebarOrder.findIndex((item) => item.slug === component.slug)
const previous = sidebarOrder[index - 1]
const next = sidebarOrder[index + 1]
const isSidebar = component.slug === "sidebar"
const sidebarExamples = [
  ["workspace", "Workspace", "An inset layout with a team switcher, nested projects, a toggle rail, and an account menu."],
  ["docs", "Documentation", "A searchable documentation tree with independent sections and off-canvas navigation."],
  ["mail", "Mail", "A folder rail beside a searchable message list. Filter unread mail and open a message."],
  ["floating", "Floating right", "A rounded sidebar on the right with an icon-only collapsed state."],
  ["mobile", "Mobile sheet", "Modal navigation with its own open state, focus containment, and Escape to dismiss."],
  ["loading", "Loading", "Fixed navigation with stable placeholders until the menu loads."],
] as const
const command = `gpuicn add ${docs.installComponents.join(" ")}`
const manual = `// src/ui/mod.rs\n${docs.modules.map((module) => `pub mod ${module};`).join("\n")}\n\n// src/main.rs\nmod ui;`
const files = docs.modules.map((module) => `src/ui/${module}.rs`)
const lines = docs.source.split("\n").length
---

<Docs
  title={component.name}
  part={category.title}
  partHref={`/components/#${category.id}`}
  lede={component.description}
>
  <p class="meta" slot="head">
    {isNew(component) && <span class="badge badge--new">New</span>}
    <span class="badge badge--quiet">{addedLabel(component)}</span>
    <span class="badge badge--quiet">{lines} lines of Rust</span>
  </p>

  <figure class="figure" id="preview" data-tabs>
    <div class="figure__frame">
      <div class="figure__bar">
        <div class="tabs__list" role="tablist" aria-label="Preview or its source">
          <button class="tabs__tab" type="button" role="tab" id="tab-preview" aria-controls="panel-preview" aria-selected="true" tabindex="0">Preview</button>
          <button class="tabs__tab" type="button" role="tab" id="tab-code" aria-controls="panel-code" aria-selected="false" tabindex="-1">Preview source</button>
        </div>
        <span class="spacer"></span>
        <button class="btn btn--ghost btn--sm" type="button" aria-pressed="false" data-preview-rtl title="Preview in a right-to-left layout">RTL</button>
        <button class="btn btn--ghost btn--sm" type="button" data-preview-reset title="Start the preview again">Reset</button>
        <a class="btn btn--ghost btn--sm" href={`/app/?c=${component.slug}`} title="Open this component in the gallery app">
          Gallery
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
      </div>
      <div class="tabs__panel" role="tabpanel" id="panel-preview" aria-labelledby="tab-preview">
        {
          isSidebar && (
            <div class="examples" data-sidebar-examples>
              <div class="examples__chips" role="group" aria-label="Sidebar examples">
                {sidebarExamples.map(([value, label]) => (
                  <button class="chip" type="button" data-example={value} aria-pressed={value === "workspace" ? "true" : "false"}>
                    {label}
                  </button>
                ))}
              </div>
              {sidebarExamples.map(([value, , blurb]) => (
                <p class="small" data-example-blurb={value} hidden={value !== "workspace"}>
                  {blurb}
                </p>
              ))}
            </div>
          )
        }
        <Preview id="component-preview" slug={component.slug} name={component.name} example={isSidebar ? "workspace" : undefined} />
      </div>
      <div class="tabs__panel" role="tabpanel" id="panel-code" aria-labelledby="tab-code" hidden>
        {
          isSidebar && docs.examples ? (
            Object.entries(docs.examples).map(([value, source]) => (
              <div data-example-code={value} hidden={value !== "workspace"}>
                <Code code={source} class="code--flush" />
              </div>
            ))
          ) : (
            <Code code={docs.preview} class="code--flush" />
          )
        }
      </div>
    </div>
    <figcaption class="figure__caption">
      The real {component.name}, drawn by GPUI in your browser. It follows the theme menu in the header.
      The second tab is the preview's own source
      (<code>site/src/previews/{component.slug.replaceAll("-", "_")}.rs</code>);
      <a href="/examples/showcase.rs" download>download the whole showcase</a> for its imports and helpers.
    </figcaption>
  </figure>

  <section class="section" id="installation">
    <h2 class="h2">Installation</h2>
    <Aside>
      <p>Files this command writes:</p>
      <ul class="files">
        {files.map((file) => <li><code>{file}</code></li>)}
      </ul>
      <p>
        {docs.installComponents.length > 1
          ? `${component.name} depends on ${docs.installComponents.slice(1).join(", ")}, so the command installs them too.`
          : "The theme module is shared by every component and is written once."}
      </p>
    </Aside>
    <div class="text">
      <p>
        After the one-time <a href="/installation/">setup</a>, run the command from your app root. The CLI
        writes the modules and keeps <code>src/ui/mod.rs</code> in step.
      </p>
    </div>
    <Code code={command} lang="bash" />
    <div class="text">
      <p>If you prefer to copy the files by hand, declare them yourself:</p>
    </div>
    <Code code={manual} />
  </section>

  <section class="section" id="usage">
    <h2 class="h2">Usage</h2>
    <Aside>
      <p>
        The example compiles in CI against the installed source. Element IDs must be unique among
        siblings.
      </p>
    </Aside>
    <div class="text">
      <p>
        Put this in a view module and return <code>{docs.usageCall}</code> from its <code>render</code> method.
      </p>
    </div>
    <Code code={docs.usage} />
  </section>

  <section class="section" id="api">
    <h2 class="h2">API reference</h2>
    <Aside>
      <p>
        {docs.api.length} public functions, extracted from <code>{files[files.length - 1]}</code> ({lines} lines) at
        this release. Functions that return GPUI Kit parts also accept those parts' builder methods.
      </p>
    </Aside>
    <div class="api wide">
      {
        docs.api.map((entry) => (
          <div class="api__row">
            <pre><code>{entry.signature}</code></pre>
            {entry.description && <p>{entry.description}</p>}
          </div>
        ))
      }
    </div>
    <details class="fold">
      <summary>Installed source, {lines} lines</summary>
      <Code code={docs.source} />
    </details>
  </section>

  <section class="section" id="platform-notes">
    <h2 class="h2">Platform notes</h2>
    <Aside>
      <p>
        These notes are kept in <code>docs/parity</code> in the repository and name the shadcn/ui and
        GPUI Kit versions they were checked against.
      </p>
    </Aside>
    <div class="text platform-notes" set:html={docs.parityHtml} />
  </section>

  <nav class="pager" aria-label="Neighbouring components">
    {previous ? <a href={componentHref(previous.slug)} rel="prev"><span>Previous</span>{previous.name}</a> : <span></span>}
    {next && <a class="pager__next" href={componentHref(next.slug)} rel="next"><span>Next</span>{next.name}</a>}
  </nav>
</Docs>

<script>
  const preview = document.getElementById("component-preview")
  const remount = () => preview?.dispatchEvent(new CustomEvent("gpuicn:preview", { bubbles: true, detail: "remount" }))
  document.querySelector("[data-preview-reset]")?.addEventListener("click", remount)
  const rtl = document.querySelector<HTMLButtonElement>("[data-preview-rtl]")
  rtl?.addEventListener("click", () => {
    const on = rtl.getAttribute("aria-pressed") !== "true"
    rtl.setAttribute("aria-pressed", String(on))
    if (preview) preview.dataset.dir = on ? "rtl" : "ltr"
    remount()
  })

  // Sidebar examples: switch the preview and its source together.
  const group = document.querySelector<HTMLElement>("[data-sidebar-examples]")
  if (group && preview) {
    for (const chip of group.querySelectorAll<HTMLButtonElement>("[data-example]")) {
      chip.addEventListener("click", () => {
        const value = chip.dataset.example!
        for (const other of group.querySelectorAll<HTMLButtonElement>("[data-example]")) {
          other.setAttribute("aria-pressed", String(other === chip))
        }
        for (const blurb of group.querySelectorAll<HTMLElement>("[data-example-blurb]")) {
          blurb.hidden = blurb.dataset.exampleBlurb !== value
        }
        for (const code of document.querySelectorAll<HTMLElement>("[data-example-code]")) {
          code.hidden = code.dataset.exampleCode !== value
        }
        preview.dataset.example = value
        preview.dispatchEvent(new CustomEvent("gpuicn:preview", { bubbles: true, detail: "remount" }))
      })
    }
  }
</script>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
  }
  .pager a {
    display: grid;
    gap: 0.15rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-weight: 500;
  }
  .pager a:hover {
    border-color: var(--ink-3);
  }
  .pager a span {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-3);
  }
  .pager__next {
    text-align: right;
  }
  .section {
    margin-top: 2.75rem;
    scroll-margin-top: calc(var(--head) + 1rem);
  }
  .section > :global(* + *) {
    margin-top: 0.85rem;
  }
  :global(.code--flush) {
    border-radius: 0;
  }
  :global(.code--flush pre) {
    max-height: 40rem;
  }
  .examples {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: 0.4rem;
  }
  .examples__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .files {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .files li + li {
    margin-top: 0.15rem;
  }
  .fold {
    margin-top: 1rem;
  }
</style>
