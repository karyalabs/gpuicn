---
import { u } from "@/lib/base"
import Docs from "../../layouts/Docs.astro"
import ComponentCard from "../../components/ComponentCard.astro"
import { categories, components, isNew } from "../../lib/catalog"

const fresh = components.filter(isNew).length
---

<Docs
  title="Components"
  part="Reference"
  lede={`${components.length} components in ${categories.length} groups, ${fresh} of them new in recent releases. Every one has a live preview, a usage example, its API and platform notes.`}
  current={u("/components/")}
>
  <div class="finder" slot="head">
    <label class="finder__field">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input type="search" placeholder="Filter components" autocomplete="off" aria-label="Filter components" data-filter />
    </label>
    <a class="btn" href={u("/app/")}>Open the gallery app</a>
  </div>

  {
    categories.map((category) => (
      <section class="group" id={category.id} data-group>
        <div class="group__head">
          <h2 class="h2">{category.title}</h2>
          <span class="group__count">{category.components.length}</span>
        </div>
        <div class="grid">
          {category.components.map((component) => <ComponentCard component={component} />)}
        </div>
      </section>
    ))
  }
  <p class="small" data-empty hidden>No component matches.</p>
</Docs>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-filter]")
  const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")]
  const empty = document.querySelector<HTMLElement>("[data-empty]")
  input?.addEventListener("input", () => {
    const terms = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean)
    let any = false
    for (const group of groups) {
      let shown = 0
      for (const card of group.querySelectorAll<HTMLElement>("[data-card]")) {
        card.hidden = !terms.every((term) => (card.dataset.terms ?? "").includes(term))
        if (!card.hidden) shown += 1
      }
      group.hidden = shown === 0
      any ||= shown > 0
    }
    if (empty) empty.hidden = any
  })
</script>

<style>
  .finder {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }
  .finder__field {
    flex: 1;
    min-width: 12rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--rule-2);
    border-radius: var(--r-md);
    color: var(--ink-3);
  }
  .finder__field:focus-within {
    border-color: var(--ink);
  }
  .finder__field svg {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
  }
  .finder__field input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    background: none;
    border: 0;
    outline: 0;
  }
  .group {
    margin-top: 2.5rem;
    scroll-margin-top: calc(var(--head) + 1rem);
  }
  .group[hidden] {
    display: none;
  }
  .group__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .group__count {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--ink-3);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
