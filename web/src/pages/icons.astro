---
import { u } from "@/lib/base"
import Docs from "../layouts/Docs.astro"
import Preview from "../components/Preview.astro"
import { icons } from "../lib/docs"
import { highlight } from "../lib/highlight"

const initial = icons.find((icon) => icon.name === "house") ?? icons[0]!
const variant = initial.rust.split("::")[1]!
// Highlight once, then mark the variant token so the script can swap it.
const snippet = (
  await highlight(
    `use gpui_kit::{Styled, px, rgb};\nuse gpui_icons::{lucide, LucideIcon};\n\nlucide(${initial.rust})\n    .size(px(24.))\n    .text_color(rgb(0x171717))`,
    "rust"
  )
).replace(`>${variant}<`, ` data-icon-variant>${variant}<`)
if (!snippet.includes("data-icon-variant")) throw new Error("Icon snippet lost its variant token")
---

<Docs
  title="Icons"
  part="Reference"
  lede={`The ${icons.length.toLocaleString("en")} icons of Lucide 1.63.0, as Rust names. gpui-icons renders the original SVGs with GPUI, on native targets and in WebAssembly.`}
>
  <div class="text">
    <p>
      The Rust name is the icon name in PascalCase, so <code>a-arrow-down</code> is
      <code>LucideIcon::AArrowDown</code>. Register <code>LucideAssetSource</code> on your application,
      set the color from your theme, and give icon-only controls an accessible label.
      <a href="https://github.com/karyalabs/gpui-icons">gpui-icons</a> is a separate crate and works
      without gpuicn.
    </p>
  </div>

  <div class="icons" data-icons>
    <!-- The selected icon and the search stay in view while the grid scrolls. -->
    <div class="icons__top">
      <aside class="detail" aria-label="Selected icon" data-icon-detail>
        <div class="detail__preview">
          <Preview id="icon-preview" slug="icons" name="icon" icon={initial.name} height={150} />
        </div>
        <div class="detail__info">
          <p class="detail__name" data-icon-name>{initial.name}</p>
          <div class="code">
            <pre tabindex="0"><code class="shiki" set:html={snippet} /></pre>
            <button class="code__copy" type="button" data-copy aria-label="Copy code">
              <svg class="icon--copy" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                <path d="M15 9V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h4"></path>
              </svg>
              <svg class="icon--check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>
            </button>
            <p class="code__status" role="status" data-copy-status></p>
          </div>
          <p class="small">
            <a href={u(`/icons/lucide/${initial.name}.svg`)} download data-icon-download>Download the SVG</a>
            · <a href={u("/icons/LICENSE")}>ISC and Feather MIT terms</a>
          </p>
        </div>
      </aside>
      <div class="icons__find">
        <label class="search">
          <span class="sr-only">Search icons</span>
          <input id="icon-search" type="search" placeholder="Search names, tags, and aliases" autocomplete="off" data-icon-search />
        </label>
        <p class="small icons__count" role="status" data-icon-count>{icons.length.toLocaleString("en")} icons</p>
      </div>
    </div>
    <section aria-label="Icon catalog">
      <ul class="grid" data-icon-grid>
        {
          icons.map((icon) => (
            <li>
              <a class="cell" href={`?icon=${icon.name}`} data-icon={icon.name} aria-current={icon.name === initial.name ? "true" : undefined}>
                <img src={u(`/icons/lucide/${icon.name}.svg`)} alt="" loading="lazy" decoding="async" />
                <span>{icon.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="small icons__empty" data-icon-empty hidden>
        No icon matches. <button class="btn" type="button" data-icon-clear>Clear the search</button>
      </p>
    </section>
  </div>
</Docs>

<script>
  // Search terms are fetched once, on the first keystroke, so the page stays small.
  const root = document.querySelector<HTMLElement>("[data-icons]")!
  const input = root.querySelector<HTMLInputElement>("[data-icon-search]")!
  const count = root.querySelector<HTMLElement>("[data-icon-count]")!
  const empty = root.querySelector<HTMLElement>("[data-icon-empty]")!
  const cells = [...root.querySelectorAll<HTMLAnchorElement>(".cell")]
  const detail = root.querySelector<HTMLElement>("[data-icon-detail]")!
  const preview = document.getElementById("icon-preview")!
  let terms: Record<string, string> | null = null

  const filter = () => {
    const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean)
    let shown = 0
    for (const cell of cells) {
      const name = cell.dataset.icon!
      const text = terms?.[name] ?? name
      const match = words.every((word) => text.includes(word))
      cell.parentElement!.hidden = !match
      if (match) shown++
    }
    count.textContent = `${shown.toLocaleString("en")} icons${input.value ? ` match "${input.value}"` : ""}`
    empty.hidden = shown > 0
  }
  input.addEventListener("input", async () => {
    if (!terms) {
      terms = await fetch(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/icons/search.json`).then((response) => response.json()).catch(() => ({}))
    }
    filter()
  })
  root.querySelector("[data-icon-clear]")?.addEventListener("click", () => {
    input.value = ""
    filter()
    input.focus()
  })

  // The URL carries the selected icon; the detail panel and the preview follow it.
  const variant = (name: string) =>
    name.split("-").map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join("")
  const select = (name: string, scroll: boolean) => {
    for (const cell of cells) {
      if (cell.dataset.icon === name) cell.setAttribute("aria-current", "true")
      else cell.removeAttribute("aria-current")
    }
    detail.querySelector("[data-icon-name]")!.textContent = name
    detail.querySelector<HTMLElement>("[data-icon-variant]")!.textContent = variant(name)
    detail.querySelector<HTMLAnchorElement>("[data-icon-download]")!.href = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/icons/lucide/${name}.svg`
    preview.dataset.icon = name
    preview.dispatchEvent(new CustomEvent("gpuicn:preview", { bubbles: true }))
    // Where the panel is too big to stay in view (a phone), go to it.
    if (scroll && getComputedStyle(detail.parentElement!).position !== "sticky") {
      detail.scrollIntoView({ block: "start", behavior: "smooth" })
    }
  }
  for (const cell of cells) {
    cell.addEventListener("click", (event) => {
      event.preventDefault()
      history.replaceState(null, "", `?icon=${cell.dataset.icon}`)
      select(cell.dataset.icon!, true)
    })
  }
  const requested = new URLSearchParams(location.search).get("icon")
  const initial = requested && cells.find((cell) => cell.dataset.icon === requested)
  if (initial) select(initial.dataset.icon!, false)
</script>

<style>
  .icons {
    margin-top: 1.5rem;
  }
  .icons__top {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem 0;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.75rem;
  }
  /* Stay under the header while the grid scrolls, where there is room. */
  @media (min-width: 40rem) and (min-height: 40rem) {
    .icons__top {
      position: sticky;
      top: var(--head);
      z-index: 2;
    }
  }
  .icons__find {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .icons__find .search {
    flex: 1;
    min-width: 0;
  }
  .search input {
    width: 100%;
    height: 2.4rem;
    padding: 0 0.8rem;
    font: inherit;
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: 3px;
  }
  .search input:focus {
    outline: 0;
    border-color: var(--rubric);
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  .icons__count {
    white-space: nowrap;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .grid li[hidden] {
    display: none;
  }
  /* About 1,900 cells: skip layout and paint for the ones off screen. */
  .grid li {
    content-visibility: auto;
    contain-intrinsic-size: auto 71px;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 0.35rem 0.6rem;
    background: var(--paper);
  }
  .cell:hover {
    background: var(--paper-2);
  }
  .cell[aria-current="true"] {
    background: var(--rubric-soft);
    box-shadow: inset 0 0 0 1px var(--rubric);
  }
  .cell:focus-visible {
    outline-offset: -3px;
  }
  .cell img {
    width: 1.4rem;
    height: 1.4rem;
  }
  :global([data-theme="dark"]) .cell img {
    filter: invert(1);
  }
  .cell span {
    width: 100%;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.6rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .icons__empty {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem 0;
  }
  /* The preview has one fixed width; long icon names and code lines
     scroll or truncate beside it. */
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    min-width: 0;
    scroll-margin-top: calc(var(--head) + 0.75rem);
  }
  @media (min-width: 40rem) {
    .detail {
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: center;
    }
  }
  .detail__preview {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .detail__info {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }
  .detail__name {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .detail :global(.code) {
    min-width: 0;
  }
  .detail :global(.code pre) {
    max-height: 9rem;
    padding-block: 0.6rem;
  }
  .detail .small a {
    color: var(--rubric);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
