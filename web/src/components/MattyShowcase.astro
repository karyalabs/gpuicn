---
import { u } from "@/lib/base"
---

<section class="matty" aria-labelledby="matty-title">
  <div class="matty__intro">
    <div>
      <p class="small">Built with gpuicn by Karya Labs</p>
      <h2 class="h2" id="matty-title">See gpuicn in a real app.</h2>
      <p class="matty__description">
        Matty is an open-source Mattermost client built with gpuicn. Explore channels,
        open threads, and try the composer in a sample workspace. No account needed.
      </p>
    </div>
    <div class="matty__actions">
      <a class="btn btn--primary" href="https://demo.karyalabs.dev/matty/">Try Matty</a>
      <a class="btn" href={u("/showcase/#inside-matty")}>Explore the components</a>
      <a class="matty__source" href="https://github.com/karyalabs/matty">View source</a>
    </div>
  </div>
  <figure>
    <a class="matty__screen" href="https://demo.karyalabs.dev/matty/" aria-label="Try the Matty demo in your browser">
      <img class="matty__light" src={u("/showcase/matty-thread-light.png")} alt="Matty with channel navigation, a conversation and its thread open beside it" width="2400" height="1600" decoding="async" />
      <img class="matty__dark" src={u("/showcase/matty-thread-dark.png")} alt="Matty with channel navigation, a conversation and its thread open beside it" width="2400" height="1600" decoding="async" loading="lazy" />
    </a>
    <figcaption class="small">A real app, from sidebar to reply. Open the demo to try it in your browser.</figcaption>
  </figure>
</section>

<style>
  .matty { margin-bottom: 3.5rem; }
  .matty__intro { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.25rem 2rem; margin-bottom: 1.5rem; }
  .matty__intro .h2 { margin: 0.45rem 0 0.65rem; font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -0.03em; }
  .matty__description { max-width: 40rem; color: var(--ink-2); line-height: 1.65; }
  .matty__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 0.6rem; }
  .matty__source { padding: 0.5rem; font-size: 0.88rem; text-decoration: underline; text-underline-offset: 0.2em; }
  .matty__screen { display: block; overflow: hidden; border: 1px solid var(--rule-2); border-radius: calc(var(--radius) * 1.4); }
  .matty__screen img { display: block; width: 100%; height: auto; }
  .matty__screen .matty__dark { display: none; }
  :global([data-theme="dark"]) .matty__screen .matty__light { display: none; }
  :global([data-theme="dark"]) .matty__screen .matty__dark { display: block; }
  figcaption { margin-top: 0.75rem; }
</style>
