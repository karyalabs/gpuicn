---
import Thumb from "./Thumb.astro"
import { componentHref, isNew, type CatalogComponent } from "../lib/catalog"

interface Props {
  component: CatalogComponent
}
const { component } = Astro.props
---

<a class="card" href={componentHref(component.slug)} data-card data-terms={`${component.name} ${component.slug} ${component.description}`.toLowerCase()}>
  <Thumb slug={component.slug} name={component.name} />
  <span class="card__text">
    <span class="card__name">
      {component.name}
      {isNew(component) && <span class="badge badge--new">New</span>}
    </span>
    <span class="card__desc">{component.description}</span>
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    overflow: hidden;
    transition: border-color 120ms;
  }
  .card:hover {
    border-color: var(--ink-3);
  }
  .card[hidden] {
    display: none;
  }
  .card__text {
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem 0.85rem;
    border-top: 1px solid var(--rule);
  }
  .card__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    font-size: 0.92rem;
  }
  .card__desc {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
