---
import { categories, componentHref, isNew, guide, reference } from "../lib/catalog"

interface Props {
  current: string
}
const { current } = Astro.props
const active = (href: string) => (current === href ? "page" : undefined)
---

<!-- Docs navigation: the guide, the reference pages, then every component
     under its category. On narrow screens it folds behind a button. -->
<aside class="side">
  <button class="side__toggle" type="button" data-rail-toggle aria-expanded="false" aria-controls="side-nav">
    Menu
  </button>
  <nav class="side__nav" id="side-nav" aria-label="Documentation">
    <p class="side__group">Get started</p>
    <ul class="side__list">
      {guide.map((page) => <li><a href={page.to} aria-current={active(page.to)}>{page.label}</a></li>)}
    </ul>
    <p class="side__group">Reference</p>
    <ul class="side__list">
      {
        reference.map((page) => (
          <li><a href={page.to} aria-current={active(page.to)}>{page.to === "/components/" ? "All components" : page.label}</a></li>
        ))
      }
    </ul>
    {
      categories.map((category) => (
        <>
          <p class="side__group">{category.title}</p>
          <ul class="side__list">
            {category.components.map((component) => (
              <li>
                <a href={componentHref(component.slug)} aria-current={active(componentHref(component.slug))}>
                  {component.name}
                  {isNew(component) && <span class="side__new" aria-label="New"></span>}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </nav>
</aside>
<script is:inline>
  // Pages are separate documents, so keep the sidebar's scroll position across
  // navigations, and bring the current page into view if it is hidden.
  ;(() => {
    const side = document.currentScript.previousElementSibling
    const key = "gpuicn-side"
    try {
      const saved = sessionStorage.getItem(key)
      if (saved) side.scrollTop = Number(saved)
    } catch {}
    const current = side.querySelector('[aria-current="page"]')
    if (current) {
      const item = current.getBoundingClientRect()
      const box = side.getBoundingClientRect()
      if (item.top < box.top + 48 || item.bottom > box.bottom - 24) {
        side.scrollTop += item.top - box.top - box.height / 3
      }
    }
    addEventListener("pagehide", () => {
      try {
        sessionStorage.setItem(key, String(side.scrollTop))
      } catch {}
    })
  })()
</script>

<style>
  .side {
    font-size: 0.88rem;
    border-bottom: 1px solid var(--rule);
  }
  .side__toggle {
    width: 100%;
    text-align: left;
    padding: 0.8rem 0;
    font-weight: 500;
    display: flex;
    justify-content: space-between;
  }
  .side__toggle::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid var(--ink-2);
    border-bottom: 1.5px solid var(--ink-2);
    transform: translateY(0.1rem) rotate(45deg);
  }
  .side__toggle[aria-expanded="true"]::after {
    transform: translateY(0.3rem) rotate(-135deg);
  }
  .side__nav {
    display: none;
    padding-bottom: 1rem;
  }
  .side__toggle[aria-expanded="true"] + .side__nav {
    display: block;
  }
  .side__group {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--ink);
    padding: 1.4rem 0 0.35rem;
  }
  .side__group:first-child {
    padding-top: 0;
  }
  .side__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .side__list a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.24rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: var(--r-sm);
    color: var(--ink-2);
  }
  .side__list a:hover {
    color: var(--ink);
  }
  .side__list a[aria-current="page"] {
    color: var(--ink);
    font-weight: 500;
    background: var(--paper-2);
  }
  .side__new {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (min-width: 64rem) {
    .side {
      border: 0;
      position: sticky;
      top: var(--head);
      align-self: start;
      max-height: calc(100vh - var(--head));
      overflow-y: auto;
      padding: 3rem 0.85rem 3rem 0.6rem;
      margin-left: -0.6rem;
      scrollbar-width: thin;
      view-transition-name: side;
    }
    .side__toggle {
      display: none;
    }
    .side__nav {
      display: block;
    }
  }
</style>
