---
import { u } from "@/lib/base"
import "../styles/global.css"
import Palette from "../components/Palette.astro"
import Logo from "../components/Logo.astro"
import ThemeControls from "../components/ThemeControls.astro"
import { components } from "../lib/catalog"

interface Props {
  title?: string
  description?: string
  /** Leaves out the footer, for a page that fills the window. */
  bare?: boolean
}

const {
  title,
  description = `Components for GPUI, installed as Rust source you own. ${components.length} components, the complete Lucide icon library, and live previews rendered by GPUI.`,
  bare = false,
} = Astro.props
const fullTitle = title ? `${title} · gpuicn` : "gpuicn · Components for GPUI, installed as source"
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href={u("/favicon-panels.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={u("/apple-touch-icon-panels.png")} />
    <link rel="preload" href={u("/type/Geist-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={u("/type/Geist-Medium.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={u("/type/Geist-SemiBold.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={u("/type/GeistMono-Regular.woff2")} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gpuicn" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(u("/og-gpuicn-beta.jpg"), Astro.site).href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="gpuicn beta. Native components. Your source code. Ivory and orange overlapping panels on a dark background."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(u("/og-gpuicn-beta.jpg"), Astro.site).href} />
    <meta name="theme-color" content="#fdfdfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151514" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Runs before paint so the stored theme never flashes.
      ;(function () {
        var stored = null
        try {
          stored = localStorage.getItem("gpuicn-theme")
        } catch (_) {}
        var dark =
          stored === "dark" ||
          (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches)
        var root = document.documentElement
        root.dataset.theme = dark ? "dark" : "light"
        // The theme menu's choice: base color, accent and radius.
        var style = null
        try {
          style = localStorage.getItem("gpuicn-style")
        } catch (_) {}
        var parts = /^([a-z]+)-([a-z]+)-(\d(?:\.\d+)?)$/.exec(style || "")
        if (parts) {
          root.dataset.style = style
          root.dataset.accent = parts[2]
          root.style.setProperty("--radius", parts[3] + "rem")
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="head">
      <div class="head__row">
        <a class="head__brand" href={u("/")} aria-label="gpuicn home">
          <Logo size={20} />
          <span>gpuicn</span>
        </a>
        <nav class="head__nav" aria-label="Main">
          <a href={u("/introduction/")}>Docs</a>
          <a href={u("/components/")}>Components</a>
          <a href={u("/icons/")}>Icons</a>
          <a href={u("/app/")}>Gallery app</a>
        </nav>
        <div class="head__tools">
          <details class="head__menu head__more" data-theme-menu>
            <summary class="head__tool" aria-label="Menu">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            </summary>
            <nav class="head__popup head__links" aria-label="Main, small screens">
              <a href={u("/introduction/")}>Docs</a>
              <a href={u("/components/")}>Components</a>
              <a href={u("/icons/")}>Icons</a>
              <a href={u("/app/")}>Gallery app</a>
            </nav>
          </details>
          <button class="head__tool" type="button" data-open-palette>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <span class="head__tool-label">Search</span>
            <kbd class="head__kbd" aria-hidden="true">⌘K</kbd>
          </button>
          <details class="head__menu" data-theme-menu>
            <summary class="head__tool" aria-label="Theme: base color, accent and radius">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"></path>
                <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
                <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
                <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
                <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              </svg>
              <span class="head__tool-label">Theme</span>
            </summary>
            <div class="head__popup">
              <p class="head__popup-title">Theme the previews</p>
              <p class="head__popup-text">Every preview on the site is live GPUI and follows these.</p>
              <ThemeControls command />
            </div>
          </details>
          <button class="head__tool" type="button" data-theme-toggle aria-label="Switch between light and dark">
            <svg class="icon--sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg class="icon--moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
          </button>
          <a class="head__tool" href="https://github.com/karyalabs/gpuicn" aria-label="gpuicn on GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main" class="main">
      <slot />
    </main>

    {!bare && <footer class="colophon">
      <div class="colophon__row">
        <p>
          gpuicn is open source under the MIT license. Every preview on this site is the real component,
          compiled to WebAssembly and drawn by GPUI.
        </p>
        <nav class="colophon__links" aria-label="Footer">
          <a href="https://github.com/karyalabs/gpuicn">GitHub</a>
          <a href="https://github.com/karyalabs/gpuicn/releases">Releases</a>
          <a href="https://crates.io/crates/gpuicn">crates.io</a>
          <a href="https://github.com/karyalabs/gpui-icons">gpui-icons</a>
        </nav>
      </div>
    </footer>}

    <Palette />
    <script src="../scripts/site.ts"></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 0.85rem;
  }
  .skip:focus {
    top: 0.5rem;
  }

  .head {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--head);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    font-size: 0.9rem;
  }
  .head__row {
    height: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .head__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
  }
  .head__nav {
    display: none;
    gap: 1.35rem;
    margin-left: 1.25rem;
    margin-right: auto;
    color: var(--ink-2);
  }
  .head__menu {
    position: relative;
  }
  .head__menu > summary {
    list-style: none;
    cursor: pointer;
  }
  .head__menu > summary::-webkit-details-marker {
    display: none;
  }
  .head__menu[open] > summary {
    color: var(--ink);
    background: var(--paper-2);
  }
  .head__popup {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: -4rem;
    width: min(19.5rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--rule-2);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.14);
  }
  .head__links {
    width: 12rem;
    padding: 0.4rem;
    display: grid;
  }
  .head__links a {
    padding: 0.45rem 0.6rem;
    border-radius: var(--r-sm);
  }
  .head__links a:hover {
    background: var(--paper-2);
  }
  @media (min-width: 48rem) {
    .head__more {
      display: none;
    }
  }
  .head__popup-title {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .head__popup-text {
    color: var(--ink-2);
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0.15rem 0 0.9rem;
  }
  .head__nav a:hover {
    color: var(--ink);
  }
  .head__tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  @media (min-width: 48rem) {
    .head__nav {
      display: flex;
    }
    .head__popup {
      right: 0;
    }
  }
  .head__tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 1.9rem;
    padding: 0 0.5rem;
    border-radius: var(--r-sm);
    color: var(--ink-2);
  }
  .head__tool:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .head__tool svg {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Below 48rem the label is visually hidden but still names the button. */
  .head__tool-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .head__kbd {
    display: none;
  }
  .head__kbd {
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--ink-3);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.05rem 0.25rem;
  }
  @media (min-width: 48rem) {
    .head__tool-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .head__kbd {
      display: inline;
    }
  }
  .icon--sun {
    display: none;
  }
  :global([data-theme="dark"]) .icon--sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon--moon {
    display: none;
  }

  .main {
    flex: 1;
  }

  .colophon {
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.84rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .colophon__row {
    max-width: var(--shell);
    margin-inline: auto;
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .colophon p {
    max-width: 36rem;
  }
  .colophon__links {
    display: flex;
    gap: 1.25rem;
    align-self: flex-start;
  }
  .colophon__links a:hover {
    color: var(--ink);
  }
</style>
